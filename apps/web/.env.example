# Local offline (default product path)
SALOMON_GGUF=
SALOMON_LOCAL_MODEL=
SALOMON_ALLOW_ASK_STUB=1
SALOMON_OFFLINE=1

# Remote mode: set to enable REMOTE GATEWAY (labeled, never silent). Never commit a real key.
