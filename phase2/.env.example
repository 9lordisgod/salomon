# Phase 2 M4 propose-only config. Lead owns values; PS reviews non-empty IDs.
# Testnet first. No hardcoded mainnet IDs in code or this example.
NETWORK=testnet

# Official NEAR Intents has NO testnet Verifier (and no plans for one).
# Leave empty ⇒ propose paths fail closed with env_unconfigured (correct for M4).
# Do NOT put mainnet intents.near here. Unofficial sandboxes only if Lead opts in explicitly.
# https://docs.near-intents.org/resources/faqs
# https://docs.near-intents.org/integration/verifier-contract/introduction
INTENTS_VERIFIER_ID=

# Chain Signatures MPC (testnet) — docs + view_account verified 2026-10-29
# https://docs.near.org/chain-abstraction/chain-signatures/implementation
MPC_CONTRACT_ID=v1.signer-prod.testnet

# NEAR testnet NEP-141s for propose-only schema/preview (ft_metadata verified).
# NOT official Intents Verifier assets (Intents token list is mainnet-only).
TOKEN_ALLOWLIST=wrap.testnet@24,usdc.fakes.testnet@6,usdt.fakes.testnet@6

# REQUIRED. Ceilings: testnet ≤ 1000 NEAR, mainnet ≤ 10 NEAR. Missing ⇒ deny.
MAX_DRAFT_AMOUNT=1000
